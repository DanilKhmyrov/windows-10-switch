--- a/NintendoSwitch.dsc	2026-11-11 09:56:54.025117012 +0000
+++ b/NintendoSwitch.dsc	2026-11-11 09:56:54.035117012 +0000
@@ -347,6 +347,11 @@
   # gEfiMdeModulePkgTokenSpaceGuid.PcdSerialFifoControl|0x07
   # gEfiMdeModulePkgTokenSpaceGuid.PcdSerialRegisterAccessWidth|8
 
+[PcdsFixedAtBuild.AARCH64]
+  # Same layout as the 32-bit build: system memory and the UEFI region end below hekate's
+  # framebuffer, nothing above 4 GB.
+  gArmTokenSpaceGuid.PcdSystemMemorySize|0x75A00000
+
 [PcdsFixedAtBuild.ARM]
   # 32-bit build sees only memory below 4GB. The UEFI region sits at the top of
   # this range, so end it right below hekate's framebuffer.
