diff --git a/Drivers/SdMmcDxe/SdMmc.c b/Drivers/SdMmcDxe/SdMmc.c
index a58da8a..537cdd0 100644
--- a/Drivers/SdMmcDxe/SdMmc.c
+++ b/Drivers/SdMmcDxe/SdMmc.c
@@ -276,7 +276,11 @@ VOID
 SdDiag(UINTN Stage, BOOLEAN Passed)
 {
     volatile UINT32 *Fb = (volatile UINT32 *) (UINTN) SD_DIAG_FB;
+#ifdef CLEAN_BOOT
+    UINT32 Color = Passed ? 0xFF000000 : 0xFFFF00FF;   // Clean boot: only failures show.
+#else
     UINT32 Color = Passed ? 0xFF00FF00 : 0xFFFF00FF;
+#endif
     UINTN X, Y;
     UINTN Left = 20 + (Stage - 1) * 100;
 
diff --git a/Include/Device/EarlyMark.h b/Include/Device/EarlyMark.h
index 1ed4724..442d230 100644
--- a/Include/Device/EarlyMark.h
+++ b/Include/Device/EarlyMark.h
@@ -1,6 +1,13 @@
 #ifndef _DEVICE_EARLY_MARK_H_
 #define _DEVICE_EARLY_MARK_H_
 
+// CLEAN_BOOT: the same drawing (same timing), but in black, so nothing shows.
+#ifdef CLEAN_BOOT
+#define EARLY_MARK_COLOR 0xFF000000
+#else
+#define EARLY_MARK_COLOR 0xFF00FF00
+#endif
+
 //
 // Progress squares for bring-up without a serial cable. Row above the SD card
 // squares. Green square N means startup got as far as step N.
@@ -15,7 +22,7 @@ EarlyMark(UINTN Stage)
 
   for (Y = 1060; Y < 1130; Y++) {
     for (X = Left; X < Left + 70; X++) {
-      Fb[Y * 720 + X] = 0xFF00FF00;
+      Fb[Y * 720 + X] = EARLY_MARK_COLOR;
     }
   }
 }
