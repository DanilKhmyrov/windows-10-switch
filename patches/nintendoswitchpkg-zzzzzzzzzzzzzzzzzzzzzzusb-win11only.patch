+// ---- USB host preparation (Windows 11 builds) --------------------------------------------------
+// Brings the XUSB host controller up for the inbox Windows USBXHCI driver (ACPI XHC0, PNP0D10),
+// ported from the winx UEFI for the Switch Lite (t214/usb-host.h, UsbPowerAudit.c R246/R249:
+// GPL-2.0), which follows Switchroot's xhci-tegra.c and xusb-tegra210.c. On every Mariko board
+// (Switchroot tegra210b01-nx-common.dtsi) the USB-C port is usb2-0 (OTG, high-speed current
+// offset +6) with SuperSpeed on PCIe PHY lane 5; the Wi-Fi uses lane 0, which WifiProbe prepared
+// together with the shared UPHY PLL and PLLE. The Falcon firmware is NVIDIA's and is not part of
+// this project: it is read from the FAT partition as \tegra210b01_xusb_firmware (from a
+// Switchroot Ubuntu image) at ReadyToBoot. Without the file nothing is touched. On success the
+// host is left halted and out of reset, which makes XHC0 visible (its _STA reads the reset bit).
+// The port is not powered here (no VBUS): devices need a hub or dock with its own supply.
+#define XU_CAR              0x60006000
+#define XU_PMC              0x7000E400
+#define XU_HCD              0x70090000
+#define XU_FPCI             0x70098000
+#define XU_IPFS             0x70099000
+#define XU_PAD              0x7009F000
+#define XU_FUSE             0x7000F800
+#define XU_LIC1             0x60004100
+#define XU_HOST_ASID        0x70019288
+#define XU_IRQS             (BIT7 | BIT8)   // SPI 39: xHCI, SPI 40: Falcon mailbox
+#define XU_FW_FILE          L"\\tegra210b01_xusb_firmware"
+#define XU_FW_SIZE_OK(S)    ((S) >= 65536U && (S) <= 262144U)
+
+STATIC BOOLEAN mXuDone;
+
+STATIC UINT32
+XuLe32(CONST UINT8 *P)
+{
+    return (UINT32) P[0] | ((UINT32) P[1] << 8) | ((UINT32) P[2] << 16) | ((UINT32) P[3] << 24);
+}
+
+// The firmware from the first FAT volume that has it, in reserved memory below 4 GB (the
+// Falcon keeps running from it). Header checks as in winx: B01 firmware is version 0x51.
+STATIC EFI_STATUS
+XuReadFirmware(EFI_PHYSICAL_ADDRESS *Address, UINTN *Size)
+{
+    EFI_HANDLE *Handles;
+    UINTN Count, I;
+    EFI_STATUS Status = EFI_NOT_FOUND;
+
+    if (EFI_ERROR(gBS->LocateHandleBuffer(ByProtocol, &gEfiSimpleFileSystemProtocolGuid, NULL,
+            &Count, &Handles))) return EFI_NOT_FOUND;
+    for (I = 0; I < Count && Status == EFI_NOT_FOUND; I++) {
+        EFI_SIMPLE_FILE_SYSTEM_PROTOCOL *Fs;
+        EFI_FILE_PROTOCOL *Root, *File;
+        UINT64 Length = 0;
+
+        if (EFI_ERROR(gBS->HandleProtocol(Handles[I], &gEfiSimpleFileSystemProtocolGuid, (VOID **) &Fs))) continue;
+        if (EFI_ERROR(Fs->OpenVolume(Fs, &Root))) continue;
+        if (EFI_ERROR(Root->Open(Root, &File, XU_FW_FILE, EFI_FILE_MODE_READ, 0))) {
+            Root->Close(Root);
+            continue;
+        }
+        Root->Close(Root);
+        Status = File->SetPosition(File, MAX_UINT64);
+        if (!EFI_ERROR(Status)) Status = File->GetPosition(File, &Length);
+        if (!EFI_ERROR(Status) && !XU_FW_SIZE_OK(Length)) Status = EFI_BAD_BUFFER_SIZE;
+        if (!EFI_ERROR(Status)) Status = File->SetPosition(File, 0);
+        if (!EFI_ERROR(Status)) {
+            *Address = MAX_UINT32;
+            Status = gBS->AllocatePages(AllocateMaxAddress, EfiReservedMemoryType,
+                EFI_SIZE_TO_PAGES((UINTN) Length), Address);
+            if (!EFI_ERROR(Status)) {
+                UINT8 *Data = (UINT8 *) (UINTN) *Address;
+                *Size = (UINTN) Length;
+                Status = File->Read(File, Size, Data);
+                if (!EFI_ERROR(Status) && (*Size != Length || XuLe32(Data + 100) != Length ||
+                        CompareMem(Data + 104, "XUSBFW", 6) || (XuLe32(Data + 72) >> 24) != 0x51 ||
+                        !XuLe32(Data + 12) || (UINT64) XuLe32(Data + 8) + XuLe32(Data + 12) > Length - 256))
+                    Status = EFI_COMPROMISED_DATA;
+                if (EFI_ERROR(Status)) gBS->FreePages(*Address, EFI_SIZE_TO_PAGES((UINTN) Length));
+            }
+        }
+        File->Close(File);
+        if (EFI_ERROR(Status) && Status != EFI_NOT_FOUND) break;
+    }
+    gBS->FreePool(Handles);
+    return Status;
+}
+
+STATIC BOOLEAN
+XuPowerPartition(UINT32 Id)
+{
+    UINT32 Mask = 1U << Id;
+
+    if (!(WpRd(XU_PMC, 0x038) & Mask)) {
+        WpWr(XU_PMC, 0x030, (WpRd(XU_PMC, 0x030) & ~0x1FU) | Id | BIT8);
+        if (!WpWait(XU_PMC, 0x030, BIT8, 0, 100000)) return FALSE;
+        if (!WpWait(XU_PMC, 0x038, Mask, Mask, 100000)) return FALSE;
+    }
+    return TRUE;
+}
+
+STATIC BOOLEAN
+XuRemoveClamp(UINT32 Id)
+{
+    UINT32 Mask = 1U << Id;
+
+    if (!(WpRd(XU_PMC, 0x02C) & Mask)) return TRUE;
+    WpWr(XU_PMC, 0x034, Mask);
+    return WpWait(XU_PMC, 0x02C, Mask, 0, 100000);
+}
+
+// PLLU (480 MHz for UTMI) from the 38.4 MHz crystal, and the UTMI PLL. Running PLLs are kept.
+STATIC BOOLEAN
+XuPlls(VOID)
+{
+    if ((WpRd(XU_CAR, 0x50) >> 28) != 5) return FALSE;
+    if (!(WpRd(XU_CAR, 0xC0) & BIT27)) {
+        WpRm(XU_CAR, 0xCC, 0, BIT29);
+        WpRm(XU_CAR, 0xC0, ~0xFFE00000U, BIT24 | 0x11902);
+        WpRm(XU_CAR, 0xC0, 0, BIT30);
+        if (!WpWait(XU_CAR, 0xC0, BIT27, BIT27, 2000)) return FALSE;
+    }
+    WpRm(XU_CAR, 0xC0, 0, 0x02E00000);
+    WpRm(XU_CAR, 0xC4, 0, BIT0);
+    if (!(WpRd(XU_CAR, 0x52C) & BIT31)) {
+        WpRm(XU_CAR, 0x480, ~0xFF0000FFU, (25U << 16) | BIT8);
+        WpRm(XU_CAR, 0x488, ~0xFF00003FU, 24U << 18);
+        WpRm(XU_CAR, 0x484, ~0x07FFA000U, BIT15 | 375U);
+        if (!WpWait(XU_CAR, 0x52C, BIT31, BIT31, 2000)) return FALSE;
+    }
+    return TRUE;
+}
+
+// Host and SuperSpeed partitions (XUSBC = 22, XUSBA = 20) powered, clocks from PLLP, resets off.
+STATIC BOOLEAN
+XuClocks(VOID)
+{
+    WpWr(XU_CAR, 0x310, BIT25);
+    WpWr(XU_CAR, 0x438, BIT28);
+    if (!XuPowerPartition(20) || !XuPowerPartition(22)) return FALSE;
+    WpWr(XU_CAR, 0x330, BIT25);
+    WpWr(XU_CAR, 0x448, BIT15 | BIT28);
+    WpRm(XU_CAR, 0x600, 0xE00000FFU, BIT29 | 6U);   // host: PLLP / 4
+    WpRm(XU_CAR, 0x604, 0xE00000FFU, BIT29 | 2U);   // Falcon: PLLP / 2
+    WpRm(XU_CAR, 0x608, 0xE00000FFU, 2U << 29);
+    WpRm(XU_CAR, 0x610, 0xE70000FFU, (3U << 29) | 6U);
+    RamUs(20);
+    if (!XuRemoveClamp(20) || !XuRemoveClamp(22)) return FALSE;
+    WpWr(XU_CAR, 0x43C, BIT28 | BIT15);
+    WpWr(XU_CAR, 0x314, BIT25);
+    RamUs(30);
+    return !(WpRd(XU_CAR, 0x00C) & BIT25) && !(WpRd(XU_CAR, 0x35C) & (BIT28 | BIT15 | BIT14));
+}
+
+// UTMI pad of usb2-0 with the fuse calibration, then lane 5 for usb3-0. Lane 0 (Wi-Fi) and the
+// UPHY PLL belong to WifiProbe: no padctl or UPHY reset here.
+STATIC BOOLEAN
+XuPads(VOID)
+{
+    UINT32 Cal, Ext, Hs;
+
+    if (!(WpRd(XU_PAD, 0x360) & BIT15) || !(WpRd(XU_CAR, 0xEC) & BIT11)) return FALSE;
+    WpWr(XU_CAR, 0x328, BIT7);                      // fuse clock
+    RamUs(5);
+    Cal = WpRd(XU_FUSE, 0x1F0);
+    Ext = WpRd(XU_FUSE, 0x350);
+    WpLog(Cal);
+    if (Cal == MAX_UINT32 || Ext == MAX_UINT32 || !Cal) return FALSE;
+    Hs = ((Cal & 0x3F) + 6U) & 0x3F;
+    WpRm(XU_PAD, 0x004, 3U | (3U << 18), 1U | BIT18);
+    WpRm(XU_PAD, 0x008, 3U, 3U);                    // port 0: OTG
+    WpRm(XU_PAD, 0x088, 0x3FU | BIT26 | BIT29, Hs);
+    WpRm(XU_PAD, 0x08C, BIT2 | (0xFU << 3) | (0x1FU << 26), ((Cal >> 7) & 0xF) << 3 | ((Ext & 0x1F) << 26));
+    WpRm(XU_PAD, 0x084, 7U << 6, BIT7);
+    WpRm(XU_PAD, 0x080, BIT0, 0);
+    WpRm(XU_CAR, 0x6CC, 0xE00000FFU, 6);
+    WpWr(XU_CAR, 0x29C, BIT18);
+    WpRm(XU_PAD, 0x288, (0x7FU << 12) | (0x7FU << 19), (0x1EU << 12) | (0xAU << 19));
+    WpRm(XU_PAD, 0x284, BIT11 | 0x3FU, (7U << 3) | ((Cal >> 29) & 7U));
+    RamUs(1);
+    WpRm(XU_PAD, 0x288, BIT26, 0);
+    RamUs(100);
+
+    WpRm(XU_PAD, 0x028, 3U << 22, (1U << 22) | BIT6);   // pcie-5 = usb3-0
+    WpRm(XU_PAD, 0x024, BIT29, 0); RamUs(150);
+    WpRm(XU_PAD, 0x024, BIT30, 0); RamUs(150);
+    WpRm(XU_PAD, 0x024, BIT31, 0);
+    WpRm(XU_PAD, 0x014, BIT4 | 7U, 0);
+    WpRm(XU_PAD, 0xA60, 3U << 16, 2U << 16);
+    WpRm(XU_PAD, 0xA64, 0xFFFFU, 0x00FC);
+    WpWr(XU_PAD, 0xA68, 0xC0077F1F);
+    WpRm(XU_PAD, 0xA6C, 0xFFFFU << 16, 0x01C7U << 16);
+    WpWr(XU_PAD, 0xA74, 0xFCF01368);
+    WpRm(XU_PAD, 0x024, BIT2, 0); RamUs(150);
+    WpRm(XU_PAD, 0x024, BIT1, 0); RamUs(150);
+    WpRm(XU_PAD, 0x024, BIT0, 0);
+    WpRm(XU_PAD, 0xC60, BIT14 | (3U << 16) | (0xFU << 18), BIT16);
+    return (WpRd(XU_PAD, 0x088) & 0x3F) == Hs &&
+           (WpRd(XU_PAD, 0x028) & ((3U << 22) | BIT6)) == ((1U << 22) | BIT6);
+}
+
+// Linux tegra_xusb_load_firmware(): the Falcon boot ROM copies the image from system memory
+// (through the CSB window at FPCI 0x800, page selected by FPCI 0x41C), then the Falcon starts and
+// the controller clears USBSTS.CNR.
+STATIC BOOLEAN
+XuFalcon(UINT8 *Fw, UINTN Size, EFI_PHYSICAL_ADDRESS Address)
+{
+    volatile UINT32 *Fpci = (volatile UINT32 *) (UINTN) XU_FPCI;
+    UINT32 Tag = XuLe32(&Fw[8]), Code = XuLe32(&Fw[12]);
+    UINT32 TagBlocks = (Tag + 255U) / 256U, SizeBlocks = (Code + 255U) / 256U;
+    UINT32 Lo = (UINT32) (Address + 256U);
+    UINT32 Result = 0, Poll, Sts = MAX_UINT32;
+    UINT32 Saved = Fpci[0x41C / 4];
+    BOOLEAN Ok = FALSE;
+
+    if (Address + Size > 0x100000000ULL || (Lo & 0xFF)) return FALSE;
+    WriteBackDataCacheRange(Fw, Size);
+    ArmDataSynchronizationBarrier();
+    Fpci[0x41C / 4] = 0x80D;
+    Fpci[0x800 / 4] = (UINT32) Size;                            // ILOAD_ATTR
+    Fpci[0x808 / 4] = (UINT32) ((Address + 256U) >> 32);        // ILOAD_BASE_HI
+    Fpci[0x41C / 4] = 0x80D;
+    Fpci[0x804 / 4] = Lo;                                       // ILOAD_BASE_LO
+    Fpci[0x41C / 4] = 0x80C;
+    Fpci[0x81C / 4] = 0x80000000U;                              // APMAP_BOOTPATH
+    Fpci[0x41C / 4] = 0x80D;
+    Fpci[0x814 / 4] = 0x40000000U;                              // L2IMEM invalidate all
+    Fpci[0x810 / 4] = ((TagBlocks & 0x3FF) << 8) | ((SizeBlocks & 0xFF) << 24);
+    Fpci[0x814 / 4] = 0x11000000U;                              // load locked result
+    Fpci[0x41C / 4] = 0;
+    Fpci[0x958 / 4] = SizeBlocks;                               // IMFILLCTL
+    Fpci[0x954 / 4] = (TagBlocks & 0xFFFF) | (((TagBlocks + SizeBlocks) & 0xFFFF) << 16);
+    Fpci[0x90C / 4] = 0;                                        // FALC_DMACTL
+    for (Poll = 0; Poll < 100; Poll++) {
+        Fpci[0x41C / 4] = 0x80D;
+        Result = Fpci[0x818 / 4];                               // L2IMEMOP_RESULT
+        if (Result != MAX_UINT32 && (Result & BIT31)) { Ok = TRUE; break; }
+        WpMs(100);
+    }
+    WpLog(Result);
+    if (!Ok) { Fpci[0x41C / 4] = Saved; return FALSE; }
+
+    Fpci[0x41C / 4] = 0;
+    RamUs(10);
+    if (Fpci[0x900 / 4] == MAX_UINT32 || (Fpci[0x900 / 4] & BIT1)) { Fpci[0x41C / 4] = Saved; return FALSE; }
+    Fpci[0x904 / 4] = Tag;                                      // FALC_BOOTVEC
+    Fpci[0x900 / 4] = BIT1;                                     // FALC_CPUCTL: start
+    Ok = FALSE;
+    for (Poll = 0; Poll < 200; Poll++) {
+        Sts = MmioRead32(XU_HCD + 0x24);                        // USBSTS
+        if (Sts == MAX_UINT32 || (Sts & BIT12)) break;
+        if (!(Sts & BIT11)) { Ok = TRUE; break; }
+        RamUs(1000);
+    }
+    WpLog(Sts);
+    Fpci[0x41C / 4] = Saved;
+    return Ok;
+}
+
+STATIC VOID
+XusbPrepare(VOID)
+{
+    EFI_PHYSICAL_ADDRESS Address = 0;
+    UINTN Size = 0;
+    UINT32 Stage, Asid = 0, Cap, Op, Id;
+    BOOLEAN Decode = FALSE, Dma = FALSE;
+
+    if ((MmioRead32(0x70000804) & 0xFFF0) != 0x2120) return;   // Tegra X1+ (T210B01) only
+    if (EFI_ERROR(XuReadFirmware(&Address, &Size))) return;     // no firmware: no USB, silently
+    mWpRowCount = 0;
+
+    // Stage 1: PLLU and the UTMI PLL.
+    Stage = 0x300 | 1;
+    if (!XuPlls()) goto Failed;
+    // Stage 2: power partitions, clocks and resets of the host.
+    Stage = 0x300 | 2;
+    if (!XuClocks()) goto Failed;
+    // Stage 3: UTMI pad and lane 5.
+    Stage = 0x300 | 3;
+    if (!XuPads()) goto Failed;
+    // Stage 4: the FPCI configuration space answers; memory decode and bus mastering on.
+    Stage = 0x300 | 4;
+    WpRm(XU_IPFS, 0x180, 0, BIT0);
+    RamUs(20);
+    Id = MmioRead32(XU_FPCI);
+    WpLog(Id);
+    if (Id != 0x0FAC10DE && Id != 0x0FAD10DE) goto Failed;
+    MmioAnd16(XU_FPCI + 4, (UINT16) ~BIT2);
+    if (MmioRead16(XU_FPCI + 4) & BIT2) goto Failed;
+    Asid = MmioRead32(XU_HOST_ASID);
+    MmioWrite32(XU_HOST_ASID, 0);
+    Decode = TRUE;
+    if (MmioRead32(XU_HOST_ASID) != 0) goto Failed;
+    WpRm(XU_FPCI, 0x10, ~0x7FFFU, XU_HCD);
+    RamUs(200);
+    MmioOr16(XU_FPCI + 4, (UINT16) (BIT1 | BIT2));
+    Dma = TRUE;
+    WpRm(XU_IPFS, 0x188, 0, BIT16);
+    WpWr(XU_IPFS, 0x1BC, 0x80);
+    // Stage 5: Falcon firmware; the xHCI must come up halted with at least 5 ports.
+    Stage = 0x300 | 5;
+    Cap = MmioRead32(XU_HCD);
+    Op = Cap & 0xFF;
+    WpLog(Cap);
+    if (Op != 0x20 || (Cap >> 16) != 0x0100) goto Failed;
+    if (!XuFalcon((UINT8 *) (UINTN) Address, Size, Address)) goto Failed;
+    if (!(MmioRead32(XU_HCD + Op + 4) & BIT0) || (MmioRead32(XU_HCD + 4) >> 24) < 5) goto Failed;
+    // Stage 6: xHCI and mailbox interrupts to the CPU (GIC), not the COP.
+    Stage = 0x300 | 6;
+    WpWr(XU_LIC1, 0x2C, WpRd(XU_LIC1, 0x2C) & ~XU_IRQS);
+    WpWr(XU_LIC1, 0x1C, XU_IRQS);
+    WpWr(XU_LIC1, 0x24, XU_IRQS);
+    if ((WpRd(XU_LIC1, 0x20) & XU_IRQS) != XU_IRQS) goto Failed;
+    ArmDataSynchronizationBarrier();
+    return;
+
+Failed:
+    // Bus mastering off and the host back in reset: XHC0 stays hidden and Windows never meets a
+    // half-started controller.
+    if (Dma) MmioAnd16(XU_FPCI + 4, (UINT16) ~BIT2);
+    if (Decode) MmioWrite32(XU_HOST_ASID, Asid);
+    WpWr(XU_CAR, 0x310, BIT25);
+    if (!Dma) gBS->FreePages(Address, EFI_SIZE_TO_PAGES(Size));
+    WpDraw(Stage, FALSE);
+    RamUs(20000000);
+}
+
+STATIC VOID EFIAPI
+XusbReadyToBoot(EFI_EVENT Event, VOID *Context)
+{
+    if (mXuDone) return;
+    mXuDone = TRUE;
+    gBS->CloseEvent(Event);
+    XusbPrepare();
+}
+
+// The firmware sits on the FAT partition, which only exists once the SD card is up: the
+// preparation runs at ReadyToBoot, before the Windows Boot Manager starts.
+STATIC VOID
+XusbArm(VOID)
+{
+    EFI_EVENT Event;
+
+    EfiCreateEventReadyToBootEx(TPL_CALLBACK, XusbReadyToBoot, NULL, &Event);
+}
+
 // Windows has no fan driver, so run the fan at a fixed speed. This repeats
 // what hekate does in fan_set_duty() and regulator_5v_enable().
 #define FAN_DUTY_MAX    236
