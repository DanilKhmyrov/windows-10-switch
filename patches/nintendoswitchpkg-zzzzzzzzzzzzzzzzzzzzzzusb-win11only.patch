+        // XUSB host for the inbox USBXHCI (PNP0D10), prepared by XusbPrepare in SdMmc.c (Windows 11
+        // builds) when the Falcon firmware is on the FAT partition. Layout as in winx and
+        // hayato41200/Windows-for-Switch, which verified it on hardware: _CCA = 0 (the xHCI DMA is
+        // not cache-coherent), host registers and SPI 39. Present only when the host is out of
+        // reset: XusbPrepare puts it back into reset on any failure.
+        Device (XHC0)
+        {
+            Name (_HID, "PNP0D10")
+            Name (_CID, "PNP0D10")
+            Name (_UID, Zero)
+            Name (_CCA, Zero)
+
+            OperationRegion (XCAR, SystemMemory, 0x60006000, 0x20)
+            Field (XCAR, DWordAcc, NoLock, Preserve)
+            {
+                Offset (0x0C),
+                XRST, 32,
+                Offset (0x18),
+                XENB, 32
+            }
+
+            Method (_STA, 0, Serialized)
+            {
+                If (((XRST & 0x02000000) == Zero) && ((XENB & 0x02000000) == 0x02000000))
+                {
+                    Return (0x0F)
+                }
+                Return (Zero)
+            }
+
+            Name (_CRS, ResourceTemplate ()
+            {
+                Memory32Fixed (ReadWrite, 0x70090000, 0x00008000)
+                Interrupt (ResourceConsumer, Level, ActiveHigh, Exclusive) { 0x47 }
+            })
+        }
+
+        // Falcon mailbox (SPI 40, lane-5 LFPS), for the winx tegraxusb driver (SWOA0D02).
+        Device (XFW0)
+        {
+            Name (_HID, "SWOA0D02")
+            Name (_UID, Zero)
+            Name (_CRS, ResourceTemplate ()
+            {
+                Memory32Fixed (ReadWrite, 0x70098000, 0x00001000)
+                Memory32Fixed (ReadWrite, 0x7009F5A0, 0x00000004)
+                Interrupt (ResourceConsumer, Level, ActiveHigh, Exclusive) { 0x48 }
+            })
+            Method (_STA, 0, NotSerialized)
+            {
+                Return (\_SB.XHC0._STA ())
+            }
+        }
+
     } // Scope(_SB)
 }
