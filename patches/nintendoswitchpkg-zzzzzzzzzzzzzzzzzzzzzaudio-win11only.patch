+++ b/Drivers/SdMmcDxe/SdMmc.c
@@ -1284,6 +1284,306 @@
     MmioWrite32(0x6000421C, BIT26);
     MmioWrite32(0x60004224, BIT26);
     if (!(MmioRead32(0x60004220) & BIT26)) goto Failed;
+    return;
+
+Failed:
