diff --git a/Library/NintendoSwitchPlatformLib/Arm/ArmPlatformHelper.S b/Library/NintendoSwitchPlatformLib/Arm/ArmPlatformHelper.S
new file mode 100644
index 0000000..3f8f62f
--- /dev/null
+++ b/Library/NintendoSwitchPlatformLib/Arm/ArmPlatformHelper.S
@@ -0,0 +1,45 @@
+//
+// 32-bit (AArch32) version of ArmPlatformHelper.S.
+//
+
+#include <AsmMacroIoLib.h>
+#include <Library/ArmLib.h>
+
+// First code of the firmware: paint progress square 1 (see Device/EarlyMark.h).
+ASM_FUNC(ArmPlatformPeiBootAction)
+  MOV32 (r0, 0xF5CE9550)
+  MOV32 (r3, 0xFF00FF00)
+  mov   r1, #70
+1:
+  mov   r2, #0
+2:
+  str   r3, [r0, r2, lsl #2]
+  add   r2, r2, #1
+  cmp   r2, #70
+  bne   2b
+  add   r0, r0, #0xB40
+  subs  r1, r1, #1
+  bne   1b
+  dsb
+  bx    lr
+
+// CorePos = (ClusterId * 4) + CoreId
+ASM_FUNC(ArmPlatformGetCorePosition)
+  and   r1, r0, #ARM_CORE_MASK
+  and   r0, r0, #ARM_CLUSTER_MASK
+  add   r0, r1, r0, LSR #6
+  bx    lr
+
+ASM_FUNC(ArmPlatformGetPrimaryCoreMpId)
+  MOV32 (r0, FixedPcdGet32 (PcdArmPrimaryCore))
+  bx    lr
+
+ASM_FUNC(ArmPlatformIsPrimaryCore)
+  MOV32 (r1, FixedPcdGet32 (PcdArmPrimaryCoreMask))
+  and   r0, r0, r1
+  MOV32 (r1, FixedPcdGet32 (PcdArmPrimaryCore))
+  cmp   r0, r1
+  ite   eq
+  moveq r0, #1
+  movne r0, #0
+  bx    lr
