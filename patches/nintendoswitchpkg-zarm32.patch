 #include "Serial.h"
+#include "FbFont.h"
 
 static struct tegra210_uart * const uart_ptr = (void *) CONFIG_CONSOLE_SERIAL_TEGRA210_UART_ADDRESS;
 
@@ -72,10 +74,83 @@ SerialPortInitialize
 	VOID
 )
 {
+	EarlyMark(2);
 	tegra210_uart_init();
 	return RETURN_SUCCESS;
 }
 
+#ifdef MDE_CPU_ARM
+//
+// Bring-up aid: mirror the debug log onto the screen, so no serial cable is
+// needed. The cursor lives in the reserved display area, because every UEFI
+// module links its own copy of this library.
+//
+#define FB_LOG_FB        0xF5A00000
+#define FB_LOG_STATE     0xDFB80000
+#define FB_LOG_STRIDE    720
+#define FB_LOG_COLS      90
+#define FB_LOG_ROWS      54
+
+STATIC
+VOID
+FbLogClearRow(UINT32 Row)
+{
+	volatile UINT32 *Fb = (volatile UINT32 *) (UINTN) FB_LOG_FB;
+	UINTN X, Y;
+
+	for (Y = Row * 19; Y < (Row + 1) * 19; Y++) {
+		for (X = 0; X < FB_LOG_STRIDE; X++) {
+			Fb[Y * FB_LOG_STRIDE + X] = 0xFF000000;
+		}
+	}
+}
+
+STATIC
+VOID
+FbLogPutc(UINT8 Ch)
+{
+	volatile UINT32 *State = (volatile UINT32 *) (UINTN) FB_LOG_STATE;
+	volatile UINT32 *Fb = (volatile UINT32 *) (UINTN) FB_LOG_FB;
+	UINT32 Col = State[0];
+	UINT32 Row = State[1];
+	BOOLEAN NewLine = (Ch == '\n');
+	UINTN X, Y;
+
+	if (Col >= FB_LOG_COLS || Row >= FB_LOG_ROWS) {
+		Col = 0;
+		Row = 0;
+	}
+
+	if (Ch == '\r') {
+		return;
+	}
+
+	if (!NewLine && Ch >= 0x20 && Ch <= 0x7E) {
+		CONST UINT8 *Glyph = mFbFont[Ch - 0x20];
+
+		if (Col == 0) {
+			FbLogClearRow(Row);
+		}
+		for (Y = 0; Y < 19; Y++) {
+			for (X = 0; X < 8; X++) {
+				Fb[(Row * 19 + Y) * FB_LOG_STRIDE + Col * 8 + X] =
+					(Glyph[Y] & (0x80 >> X)) ? 0xFFFFFFFF : 0xFF000000;
+			}
+		}
+		Col++;
+	}
+
+	if (NewLine || Col >= FB_LOG_COLS) {
+		Col = 0;
+		Row = (Row + 1) % FB_LOG_ROWS;
+		FbLogClearRow(Row);
+	}
+
+	State[0] = Col;
+	State[1] = Row;
+}
+#endif
+
 UINTN
 EFIAPI
 SerialPortWrite
@@ -88,6 +163,9 @@ SerialPortWrite
 
 	while (Buffer < Final)
 	{
+#ifdef MDE_CPU_ARM
+		FbLogPutc(*Buffer);
+#endif
 		tegra210_uart_tx_byte(*Buffer++);
 	}
 
