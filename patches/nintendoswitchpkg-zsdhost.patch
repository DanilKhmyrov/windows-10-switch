diff --git a/AcpiTables/Dsdt/Dsdt.asl b/AcpiTables/Dsdt/Dsdt.asl
index d310c46..02b7c18 100644
--- a/AcpiTables/Dsdt/Dsdt.asl
+++ b/AcpiTables/Dsdt/Dsdt.asl
@@ -114,5 +114,30 @@ DefinitionBlock("DsdtTable.aml", "DSDT", 1, "NVIDIA", "TEGRA210", EFI_ACPI_ARM_O
             }
         }
 
+        // SDMMC1: microSD slot. Only this controller is described to Windows.
+        Device (SDC1)
+        {
+            Name (_HID, "PNP0D40")
+            Name (_UID, Zero)
+            Method (_CRS, 0, NotSerialized)
+            {
+                Return (GCRS (0x700B0000, 0x200, 0x2E))
+            }
+
+            Method (_STA, 0, NotSerialized)
+            {
+                Return (0x0F)
+            }
+
+            Device (SDMM)
+            {
+                Name (_ADR, Zero)
+                Method (_RMV, 0, NotSerialized)
+                {
+                    Return (Zero)
+                }
+            }
+        }
+
     } // Scope(_SB)
 }
diff --git a/Drivers/SdMmcDxe/SdMmc.c b/Drivers/SdMmcDxe/SdMmc.c
index fe625c2..e8e570c 100644
--- a/Drivers/SdMmcDxe/SdMmc.c
+++ b/Drivers/SdMmcDxe/SdMmc.c
@@ -821,6 +821,9 @@ SdMmcDxeInitialize
     if (EFI_ERROR(Status)) goto exit;
     SdDiag(Stage++, TRUE);
 
+	// The slot stays at 3.3 V: hide the 1.8 V UHS modes (SDR104, SDR50) from Windows.
+	MmioAnd32(0x700B0120, ~(UINT32) 0x18);
+
 	Status = TegraMmcInit();
 	if (EFI_ERROR(Status)) goto exit;
 	SdDiag(Stage++, TRUE);
