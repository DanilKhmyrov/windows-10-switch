+
+// ---- GPU power check (test builds, GPUTEST=1) --------------------------------------------------
+// Powers the GM20B up, reads its identity (BOOT0) and powers it down again; no GPU command and no
+// DMA. Sequence of mesa-switch-woa's tegra-x1-wddm platform/t214_power.c (ruje0504-2, GPL-2.0),
+// which follows Switchroot nvgpu (platform_gk20a_tegra.c, tegra_mc_flush) and the B01 device tree:
+// the GPU rail is MAX77812 M1 ("vdd-gpu", 0.8 V at init) at I2C5 0x31 or 0x33 on every Mariko
+// board; M3 (DRAM on the 0x33 layout) and M4 (CPU) are never touched. Everything is restored in
+// reverse order. The result is always drawn (green tag: GM20B_B found) and shown for 15 s.
+#define GP_CAR              0x60006000
+#define GP_PLLP             0x0A0
+#define GP_CLOCK_X          0x280
+#define GP_CLOCK_SET        0x284
+#define GP_CLOCK_CLR        0x288
+#define GP_RESET_X          0x28C
+#define GP_RESET_SET        0x290
+#define GP_RESET_CLR        0x294
+#define GP_PLLP_OUT5        0x67C
+#define GP_GATE             BIT24           // GPU clock/reset 184
+#define GP_REF              BIT29           // GPU reference clock 189
+#define GP_OUT5_MASK        0xFF070000U
+#define GP_OUT5_204MHZ      0x02070000U     // PLLP_OUT5 = 204 MHz, as Switchroot sets before use
+#define GP_CLAMP            0x7000E6D4      // PMC GPU rail clamp
+#define GP_MC_FLUSH         0x70019970
+#define GP_MC_FLUSH_STATUS  0x70019974
+#define GP_MC_GPU           BIT2
+#define GP_BOOT0            0x57000000
+#define GP_EN_CTRL          0x06
+#define GP_M1_VOUT          0x23
+#define GP_M1_EN            BIT0
+#define GP_M1_800MV         110             // 250 mV + 110 * 5 mV
+
+STATIC BOOLEAN
+GpPmicSet(UINT8 Addr, UINT8 Reg, UINT8 Value)
+{
+    UINT8 Back;
+
+    return CpuRegWrite(Addr, Reg, Value) && CpuRegRead(Addr, Reg, &Back) && Back == Value;
+}
+
+// Memory controller flush of the GPU client: request, then wait until the status settles.
+STATIC BOOLEAN
+GpDrain(VOID)
+{
+    UINTN Try, Same;
+    UINT32 V;
+
+    MmioOr32(GP_MC_FLUSH, GP_MC_GPU);
+    if (!(MmioRead32(GP_MC_FLUSH) & GP_MC_GPU)) return FALSE;
+    for (Try = 0; Try < 100000; Try++) {
+        RamUs(10);
+        V = MmioRead32(GP_MC_FLUSH_STATUS);
+        if (V == MAX_UINT32) return FALSE;
+        if (!(V & GP_MC_GPU)) continue;
+        for (Same = 0; Same < 5 && MmioRead32(GP_MC_FLUSH_STATUS) == V; Same++);
+        if (Same == 5) return TRUE;
+    }
+    return FALSE;
 }
 
+STATIC VOID
+GpuCheck(VOID)
+{
+    UINT8 Pmic = 0, En = 0, Vout = 0, Probe;
+    UINT32 Clocks = 0, Out5 = 0, Flush = 0;
+    UINT32 Stage = 0x400 | 1, Boot0 = 0, Boot0b = 0;
+    BOOLEAN At31, At33, Rail = FALSE, Clocked = FALSE, Released = FALSE, Ok = FALSE;
+
+    mWpRowCount = 0;
+    WpLog(MmioRead32(GP_CAR + GP_RESET_X));
+    WpLog(MmioRead32(GP_CLAMP));
+    // Stage 1: T210B01, GPU still in reset and clamped (nobody uses it), PLLP running.
+    if ((MmioRead32(0x70000804) & 0xFFF0) != 0x2120) goto Done;
+    if (!(MmioRead32(GP_CAR + GP_RESET_X) & GP_GATE) || !(MmioRead32(GP_CLAMP) & 1)) goto Done;
+    if ((MmioRead32(GP_CAR + GP_PLLP) & (BIT31 | BIT30 | BIT27)) != (BIT30 | BIT27)) goto Done;
+    // Stage 2: exactly one MAX77812 answers; save M1's voltage and the enable register.
+    Stage = 0x400 | 2;
+    At31 = CpuRegRead(0x31, GP_M1_VOUT, &Probe);
+    At33 = CpuRegRead(0x33, GP_M1_VOUT, &Probe);
+    if (At31 == At33) goto Done;
+    Pmic = At31 ? 0x31 : 0x33;
+    if (!CpuRegRead(Pmic, GP_EN_CTRL, &En) || !CpuRegRead(Pmic, GP_M1_VOUT, &Vout)) goto Done;
+    Clocks = MmioRead32(GP_CAR + GP_CLOCK_X);
+    Out5 = MmioRead32(GP_CAR + GP_PLLP_OUT5);
+    Flush = MmioRead32(GP_MC_FLUSH);
+    WpLog(((UINT32) Pmic << 24) | ((UINT32) En << 16) | ((UINT32) Vout << 8));
+    WpLog(Out5);
+    // Stage 3: M1 to 0.8 V and on (read-modify-write: only the M1 bit changes).
+    Stage = 0x400 | 3;
+    Rail = TRUE;
+    if (!GpPmicSet(Pmic, GP_M1_VOUT, GP_M1_800MV) ||
+        !GpPmicSet(Pmic, GP_EN_CTRL, (UINT8) (En | GP_M1_EN))) goto Done;
+    WpMs(5);
+    // Stage 4: PLLP_OUT5 at 204 MHz, GPU clocks on.
+    Stage = 0x400 | 4;
+    Clocked = TRUE;
+    MmioWrite32(GP_CAR + GP_PLLP_OUT5, (Out5 & ~GP_OUT5_MASK) | GP_OUT5_204MHZ);
+    RamUs(2);
+    if ((MmioRead32(GP_CAR + GP_PLLP_OUT5) & GP_OUT5_MASK) != GP_OUT5_204MHZ) goto Done;
+    MmioWrite32(GP_CAR + GP_CLOCK_SET, GP_GATE | GP_REF);
+    RamUs(10);
+    if ((MmioRead32(GP_CAR + GP_CLOCK_X) & (GP_GATE | GP_REF)) != (GP_GATE | GP_REF)) goto Done;
+    // Stage 5: unclamp and release the reset.
+    Stage = 0x400 | 5;
+    Released = TRUE;
+    MmioWrite32(GP_CAR + GP_RESET_SET, GP_GATE);
+    RamUs(10);
+    MmioAnd32(GP_CLAMP, ~(UINT32) 1);
+    RamUs(10);
+    MmioWrite32(GP_CAR + GP_CLOCK_CLR, GP_GATE);
+    MmioWrite32(GP_CAR + GP_RESET_CLR, GP_GATE);
+    MmioWrite32(GP_CAR + GP_CLOCK_SET, GP_GATE);
+    if ((MmioRead32(GP_CAR + GP_RESET_X) & GP_GATE) || (MmioRead32(GP_CLAMP) & 1)) goto Done;
+    // Stage 6: memory controller flush done and released.
+    Stage = 0x400 | 6;
+    if (!GpDrain()) goto Done;
+    RamUs(10);
+    MmioAnd32(GP_MC_FLUSH, ~(UINT32) GP_MC_GPU);
+    RamUs(10);
+    // Stage 7: identity. GM20B_B (T214) is chipset 0x12E in BOOT0 bits 28:20.
+    Stage = 0x400 | 7;
+    Boot0 = MmioRead32(GP_BOOT0);
+    RamUs(10);
+    Boot0b = MmioRead32(GP_BOOT0);
+    WpLog(Boot0);
+    WpLog(Boot0b);
+    Ok = Boot0 == Boot0b && ((Boot0 >> 20) & 0x1FF) == 0x12E;
+
+Done:
+    // Power down in reverse order and restore every saved value.
+    if (Released) {
+        if (Stage >= (0x400 | 6)) GpDrain();
+        MmioOr32(GP_CLAMP, 1);
+        RamUs(10);
+        MmioWrite32(GP_CAR + GP_RESET_SET, GP_GATE);
+        RamUs(10);
+        if (!(MmioRead32(GP_CLAMP) & 1) || !(MmioRead32(GP_CAR + GP_RESET_X) & GP_GATE)) {
+            WpLog(0xDEAD0001);
+            Ok = FALSE;
+        }
+    }
+    if (Clocked) {
+        MmioWrite32(GP_CAR + GP_CLOCK_CLR, (GP_GATE | GP_REF) & ~Clocks);
+        MmioWrite32(GP_CAR + GP_CLOCK_SET, (GP_GATE | GP_REF) & Clocks);
+        MmioWrite32(GP_CAR + GP_PLLP_OUT5, (MmioRead32(GP_CAR + GP_PLLP_OUT5) & ~GP_OUT5_MASK) | (Out5 & GP_OUT5_MASK));
+    }
+    if (Released) MmioWrite32(GP_MC_FLUSH, (MmioRead32(GP_MC_FLUSH) & ~GP_MC_GPU) | (Flush & GP_MC_GPU));
+    if (Rail) {
+        UINT8 Now;
+        if (!CpuRegRead(Pmic, GP_EN_CTRL, &Now) ||
+            !GpPmicSet(Pmic, GP_EN_CTRL, (UINT8) ((Now & ~GP_M1_EN) | (En & GP_M1_EN))) ||
+            !GpPmicSet(Pmic, GP_M1_VOUT, Vout)) {
+            WpLog(0xDEAD0002);
+            Ok = FALSE;
+        }
+        WpMs(5);
+    }
+    WpDraw(Ok ? 0x400 | 8 : Stage, Ok);
+    RamUs(15000000);
+}
+
