+    WpWr(WP_AFI, WP_AFI_BAR3_SZ, WP_MEM_SIZE >> 12);
+    WpWr(WP_AFI, WP_AFI_FPCI_BAR3, (((WP_MEM_BASE >> 12) & 0x0FFFFFFF) << 4) | 1);
+    WpWr(WP_AFI, WP_AFI_BAR4_START, 0);
+    WpWr(WP_AFI, WP_AFI_BAR4_SZ, 0);
+    WpWr(WP_AFI, WP_AFI_FPCI_BAR4, 0);
+    WpWr(WP_AFI, WP_AFI_BAR5_START, 0);
+    WpWr(WP_AFI, WP_AFI_BAR5_SZ, 0);
+    WpWr(WP_AFI, WP_AFI_FPCI_BAR5, 0);
+    WpWr(WP_AFI, WP_AFI_MSI_FPCI, 0);
+    WpWr(WP_AFI, WP_AFI_MSI_BAR_SZ, 0);
+    WpWr(WP_AFI, WP_AFI_MSI_AXI, 0);
+    // Stage 7: PEX reset released, UPHY PLL and lane 0.
+    Stage = 7;
+    WpWr(WP_CAR, WP_RST_U_CLR, WP_U_PEX);
+    RamUs(20);
+    if (!WpUphy()) {
+        WpLog(WpRd(WP_PADCTL, WP_PLL_P0_1));
+        WpLog(WpRd(WP_PADCTL, WP_PLL_P0_2));
+        WpLog(WpRd(WP_PADCTL, WP_PLL_P0_8));
+        goto Done;
+    }
+    WpWr(WP_PADS, 0x0C8, 0x90B890B8);
+    // Stage 8: radio out of reset (PH0 RF_DISABLE low, PH1 high), wake pin as input.
+    Stage = 8;
+    WpGpioH(WP_H0, 0, TRUE);
+    WpMs(20);
+    WpGpioH(WP_H1, 1, TRUE);
+    WpGpioH(WP_H2, 0, FALSE);
+    WpMs(100);
+    // Stage 9: root port setup and link training.
+    Stage = 9;
+    WpRootPortInit();
+    WpWr(WP_CAR, WP_RST_U_CLR, WP_U_PCIEX);
+    WpMs(5);
+    LinkUp = WpLink();
+    WpLog(WpRd(WP_RP, 0xF00));
+    WpLog(WpRd(WP_RP, 0x090));
+    if (!LinkUp) goto Done;
+    // Stage 10: bus numbers, endpoint vendor/device ID (BCM4356 = 0x43EC14E4).
+    Stage = 10;
+    WpCfgWr(0, 0x18, 0x00010100);
+    WpCfgWr(0, 0x20, 0x0000FFF0);
+    WpCfgWr(0, 0x24, 0x0000FFF0);
+    WpCfgWr(0, 0x04, (WpCfgRd(0, 0x04) & 0xFFFF) | 0x6);
+    for (V = 0; V < 200; V++) {
+        Id = WpCfgRd(1, 0);
+        if (Id != 0xFFFFFFFF && Id != 0xFFFF0001 && (Id & 0xFFFF) != 0xFFFF && Id != 0) break;
+        WpMs(10);
+    }
+    WpLog(Id);
+    WpLog(WpRd(WP_AFI, WP_AFI_INTR_CODE));
+    if ((Id & 0xFFFF) != 0x14E4) goto Done;
+    // Stage 11: BAR0/BAR2 sizes, placed in the outbound window, memory decoding only (no DMA).
+    Stage = 11;
+    Cmd = WpCfgRd(1, 0x04) & 0xFFFF;
+    WpCfgWr(1, 0x04, Cmd & ~6U);
+    V = WpCfgRd(1, 0x10); WpCfgWr(1, 0x10, 0xFFFFFFFF); Sz0 = WpCfgRd(1, 0x10); WpCfgWr(1, 0x10, V);
+    V = WpCfgRd(1, 0x18); WpCfgWr(1, 0x18, 0xFFFFFFFF); Sz2 = WpCfgRd(1, 0x18); WpCfgWr(1, 0x18, V);
+    WpLog(Sz0);
+    WpLog(Sz2);
+    S0 = ~(Sz0 & ~0xFU) + 1;
+    S2 = ~(Sz2 & ~0xFU) + 1;
+    if (S0 == 0 || S2 == 0 || S0 > 0x100000 || S2 > 0x1000000 || (S0 & (S0 - 1)) || (S2 & (S2 - 1)) ||
+        (Sz0 & 1) || (Sz2 & 1)) goto Done;
+    A2 = (WP_MEM_BASE + S0 + S2 - 1U) & ~(S2 - 1U);
+    Window = ((A2 + S2 - 1U) & 0xFFF00000U) | ((WP_MEM_BASE >> 16) & 0xFFF0U);
+    WpCfgWr(1, 0x10, WP_MEM_BASE | (Sz0 & 0xF));
+    if ((Sz0 & 6) == 4) WpCfgWr(1, 0x14, 0);
+    WpCfgWr(1, 0x18, A2 | (Sz2 & 0xF));
+    if ((Sz2 & 6) == 4) WpCfgWr(1, 0x1C, 0);
+    WpCfgWr(0, 0x20, Window);
+    WpCfgWr(1, 0x04, (Cmd | 2U) & ~4U);
+    if ((WpCfgRd(1, 0x10) & ~0xFU) != WP_MEM_BASE || (WpCfgRd(1, 0x18) & ~0xFU) != A2 ||
+        (WpCfgRd(1, 0x04) & 6U) != 2U) goto Done;
+    // Stage 12: chip ID through the BAR0 backplane window (ChipCommon at 0x18000000).
+    Stage = 12;
+    WpCfgWr(1, 0x80, 0x18000000);
+    if (WpCfgRd(1, 0x80) != 0x18000000) goto Done;
+    V = MmioRead32(WP_MEM_BASE);
+    WpLog(V);
+    WpLog(WpRd(WP_AFI, WP_AFI_INTR_CODE));
+    Ok = (V & 0xFFFF) == 0x4356;
+    Stage = 13;
+
+Done:
+    if (Powered) WpOff(LinkUp);
+    WpDraw(Stage, Ok);
+    RamUs(20000000);
+}
