+    WpWr(WP_AFI, WP_AFI_INTR_MASK, 0);
+    WpWr(WP_AFI, WP_AFI_AFI_INTR_EN, 0);
+    WpWr(WP_AFI, WP_AFI_SM_INTR_EN, 0);
