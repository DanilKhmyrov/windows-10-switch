+    Stage = 6;
+    WpWr(WP_CAR, WP_RST_U_CLR, WP_U_AFI);
+    RamUs(20);
+    V = WpRd(WP_AFI, WP_AFI_PLLE_CONTROL);
+    WpWr(WP_AFI, WP_AFI_PLLE_CONTROL, (V & ~BIT9) | BIT1);
