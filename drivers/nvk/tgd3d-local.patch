+/* switch-wp: which StartDevice step failed (Parameters\StartStep = step, StartStepStatus). */
+static VOID record_step(ULONG step,NTSTATUS status)
+{
+    ULONG value=(ULONG)status;
+    (VOID)RtlWriteRegistryValue(RTL_REGISTRY_SERVICES,L"tegragpurender\\Parameters",
+                              L"StartStep",REG_DWORD,&step,sizeof(step));
+    (VOID)RtlWriteRegistryValue(RTL_REGISTRY_SERVICES,L"tegragpurender\\Parameters",
+                              L"StartStepStatus",REG_DWORD,&value,sizeof(value));
+}
