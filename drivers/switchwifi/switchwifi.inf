; SwitchWifi driver package from the winx project (github.com/ruje0504-2/Windows-for-Switch-Drivers,
; drivers/SwitchWifi/package/switchwifi.inf, GPL-2.0); only the strings are changed, and DriverVer
; is back-dated: the console boots with its clock in 2022, and a future date makes Inf2Cat refuse.
[Version]
Signature="$WINDOWS NT$"
Class=Net
ClassGuid={4d36e972-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=05/02/2022,0.5.5.1
CatalogFile=switchwifi.cat
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTarm64.10.0...22621

[Models.NTarm64.10.0...22621]
%Device%=Station,ACPI\SWOA0D01

[Station.NT]
Characteristics=0x84
BusType=15
*IfType=71
*MediaType=16
*PhysicalMediaType=9
*IfConnectorPresent=1
*ConnectionType=1
*DirectionType=0
*AccessType=2
*HardwareLoopback=0
CopyFiles=DriverFiles
AddReg=StationInterfaces

[StationInterfaces]
HKR,Ndi,Service,0,"switchwifi"
HKR,Ndi\Interfaces,UpperRange,0,"ndis5"
HKR,Ndi\Interfaces,LowerRange,0,"wlan,ethernet"

[Station.NT.HW]
AddReg=StationParameters

[StationParameters]
; Preserve an earlier report if Windows restages this package.
HKR,,SwitchWifiReport,0x00000002,"v=5 pending"

[Station.NT.Services]
AddService=switchwifi,0x2,StationService

[StationService]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\switchwifi.sys

[Station.NT.Wdf]
KmdfService=switchwifi,StationWdf

[StationWdf]
KmdfLibraryVersion=1.33

[DestinationDirs]
DriverFiles=13

[DriverFiles]
switchwifi.sys

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
switchwifi.sys=1

[Strings]
Provider="Windows Switch (driver from the winx project)"
Device="Nintendo Switch BCM4356 Wireless Adapter"
Disk="Nintendo Switch Wireless Driver"
